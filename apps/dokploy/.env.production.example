PORT=3000
NODE_ENV=production
DATABASE_URL=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=primary
DEPLOYTIDE_SECRET_DIGEST_KEY=
DEPLOYTIDE_OPERATOR_API_TOKEN=
DEPLOYTIDE_OPERATOR_SESSION_SECRET=
DEPLOYTIDE_SUPERADMIN_EMAILS=
DEPLOYTIDE_OPERATOR_ORIGIN=https://app.deploytide.com
DEPLOYTIDE_OPERATOR_SECRET_REFERENCES={}
DEPLOYTIDE_OPERATOR_SECRET_FILE_ROOTS=/run/secrets/deploytide
DEPLOYTIDE_LAYERRAIL_ALLOWED_HOSTS=compute.layerrail.com,.compute.layerrail.com
DEPLOYTIDE_CONTROLLER_CERTIFICATE_ENROLLMENTS={}
DEPLOYTIDE_CONTROLLER_PROXY_SECRET=
